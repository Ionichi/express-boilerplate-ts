{
	"exclude": ["node_modules/", "dist/", ".git/", ".github/", ".vscode/"],
	"include": ["src/**/*", "src/**/*.test.ts", "src/**/*.spec.ts"],
	"compilerOptions": {
		"outDir": "dist/",
		"baseUrl": "./",
		"ignoreDeprecations": "6.0", // untuk mengabaikan peringatan deprecation saat menggunakan CommonJS
		"rootDir": "./src",
		"module": "commonjs",
		"target": "ES6",
		"lib": ["ESNext", "DOM"],
		"types": ["node", "jest"],

		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,

		"noEmit": false, // true when using esbuild for bundler
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true
	}
}
