{
	"name": "boilerplate-express-js",
	"description": "Express Boilerplate using Typescript",
	"version": "2.26.1602",
	"main": "src/index.ts",
	"keywords": [
		"express",
		"boilerplate",
		"template",
		"typescript"
	],
	"author": {
		"name": "ionichi",
		"email": "feryandi2303@gmail.com"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20.16.0"
	},
	"scripts": {
		"dev": "nodemon ./src/index.ts",
		"build": "tsc && tsc-alias",
		"type-check": "tsc --noEmit",
		"bundle": "esbuild ./src/index.ts --bundle --platform=node --minify --sourcemap --outfile=dist/index.js",
		"build:bundle": "pnpm run type-check && pnpm run bundle",
		"start": "node dist/index.js",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"test:coverage": "jest --coverage",
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix",
		"format": "prettier --write src",
		"format:check": "prettier --check src"
	},
	"dependencies": {
		"dotenv": "^16.6.1",
		"express": "^4.22.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/express": "^4.17.25",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.1.0",
		"@types/supertest": "^6.0.3",
		"esbuild": "^0.23.0",
		"eslint": "^10.0.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.3.0",
		"jest": "^30.2.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.8.1",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.6",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1"
	},
	"nodemonConfig": {
		"ignore": [
			"**/*.test.ts",
			"**/*.spec.ts",
			".git",
			"node_modules"
		],
		"watch": [
			"./src/**/*.ts"
		],
		"exec": "tsx ./src/index.ts",
		"ext": "ts, js"
	}
}
