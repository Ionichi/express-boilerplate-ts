{
	"name": "boilerplate-express-js",
	"description": "Express Boilerplate using Typescript",
	"version": "2.26.1602",
	"main": "src/index.ts",
	"keywords": [
		"express",
		"boilerplate",
		"template",
		"typescript"
	],
	"author": {
		"name": "ionichi",
		"email": "feryandi2303@gmail.com"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20.16.0"
	},
	"scripts": {
		"dev": "nodemon ./src/index.ts",
		"build": "tsc && tsc-alias",
		"type-check": "tsc --noEmit",
		"bundle": "esbuild ./src/index.ts --bundle --platform=node --minify --sourcemap --outfile=dist/index.js",
		"build:bundle": "pnpm run type-check && pnpm run bundle",
		"start": "node dist/index.js",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"test:coverage": "jest --coverage",
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix",
		"format": "prettier --write src",
		"format:check": "prettier --check src"
	},
	"dependencies": {
		"dotenv": "^16.6.1",
		"express": "^4.22.1"
	},
	"devDependencies": {
		"@types/express": "^4.17.25",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.1.0",
		"@types/supertest": "^6.0.2",
		"@typescript-eslint/eslint-plugin": "8.56.0",
		"@typescript-eslint/parser": "8.56.0",
		"esbuild": "^0.23.0",
		"eslint": "10.0.0",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-config-airbnb-typescript": "^18.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-prettier": "^5.2.1",
		"jest": "^30.2.0",
		"nodemon": "^3.1.4",
		"prettier": "^3.8.1",
		"supertest": "^7.0.0",
		"ts-jest": "^29.4.6",
		"ts-node": "^10.9.2",
		"typescript": "^5.5.4"
	},
	"nodemonConfig": {
		"ignore": [
			"**/*.test.ts",
			"**/*.spec.ts",
			".git",
			"node_modules"
		],
		"watch": [
			"./src/**/*.ts"
		],
		"exec": "node -r tsconfig-paths/register -r ts-node/register src/index.ts",
		"ext": "ts, js"
	}
}
